{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Workbench",
  "version": "0.1.0",
  "identifier": "com.mgrcpas.pdfworkbench",
  "build": {
    "beforeDevCommand": "node scripts/fetch-win-binaries.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-win-binaries.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Workbench",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "resources": {
      "vendor/pdfium/": "pdfium/",
      "vendor/qpdf/": "qpdf/"
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Workbench",
  "version": "0.1.0",
  "identifier": "com.mgrcpas.pdfworkbench",
  "build": {
    "beforeDevCommand": "node scripts/fetch-win-binaries.mjs && node scripts/notices.mjs --dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-win-binaries.mjs && npm run build && node scripts/notices.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Workbench",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDFWorkbench.Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "resources": {
      "vendor/pdfium/": "pdfium/",
      "vendor/qpdf/": "qpdf/",
      "vendor/tesseract/": "tesseract/",
      "notices/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "publisher": "MGR CPAs",
    "copyright": "MGR CPAs",
    "shortDescription": "PDF Workbench",
    "longDescription": "PDF editor for MGR CPAs: viewing, page organization, markup, redaction, workpaper tickmarks, forms and OCR.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": true,
      "signCommand": {
        "cmd": "node",
        "args": ["../scripts/sign.mjs", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}

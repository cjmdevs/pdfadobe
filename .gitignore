# Dependencies / build
node_modules/
dist/
src-tauri/target/
mcp-server/node_modules/
mcp-server/dist/

# Client-data guard: PDFs and scans are ignored everywhere except the synthetic corpus.
*.pdf
*.tif
*.tiff
!tests/corpus/**/*.pdf
!tests/corpus/fixtures/*.tif
*.bak

# Env / OS / editor
.env
.env.*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs / Vite
logs
*.log
dist-ssr
*.local

# Test output
test-results/
playwright-report/
tests/corpus/generated/
tests/corpus/out/
scripts/tmp/

# Native Windows binaries fetched by scripts/fetch-win-binaries.mjs (pinned by SHA-256)
src-tauri/vendor/

# B3 edit samples made from installed Windows fonts (never commit font subsets)
tests/corpus/edit/local/

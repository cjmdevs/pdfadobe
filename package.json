{
  "name": "pdf-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license-check": "node scripts/license-check.mjs",
    "corpus": "node tests/corpus/generate.mjs",
    "corpus:irs": "node tests/corpus/fetch-irs.mjs",
    "test:rust": "node scripts/fetch-win-binaries.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run format:rust && npm test && npm run test:rust && npm run license-check",
    "fetch-win-binaries": "node scripts/fetch-win-binaries.mjs",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:windows-target": "cargo check --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@embedpdf/plugin-attachment": "^2.15.1",
    "@embedpdf/plugin-bookmark": "^2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-interaction-manager": "^2.15.1",
    "@embedpdf/plugin-print": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-rotate": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-search": "^2.15.1",
    "@embedpdf/plugin-selection": "^2.15.1",
    "@embedpdf/plugin-spread": "^2.15.1",
    "@embedpdf/plugin-thumbnail": "^2.15.1",
    "@embedpdf/plugin-tiling": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/plugin-zoom": "^2.15.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "description": "Windows desktop PDF editor for a CPA firm",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  }
}
